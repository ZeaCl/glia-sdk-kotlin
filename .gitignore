*.apk
*.ap_
*.aab
*.aar
*.dex
*.class

# Android Studio & Gradle caches
.cxx/
captures/
.navigation/
output.json
*.hprof

### --- Common: Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
google-services.json

### --- Common: Internal Tools & Audits ---
.microglia/

### --- Common: Editors & IDEs ---
# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporary & Swap Files
*.swp
*.swo
*~
*.bak

### --- Common: Operating Systems ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
