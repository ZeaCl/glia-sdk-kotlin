# Example Maestro environment variables for live ZEA Cloud backend testing
# Copy this file to .maestro/.env.local (which is gitignored) and fill in your credentials.
# Then run: maestro test --env-file .maestro/.env.local .maestro/07_live_zea_backend.yaml

GATEWAY_URL=wss://api.zea.cl
APP_ID=my-agent-app
USER_ID=my-user-id
TOKEN=my-secret-jwt-token
